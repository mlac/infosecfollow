# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Claude Code subscription token. Generate on a logged-in machine with:
#   claude setup-token
# Valid ~1 year; rotate before it expires.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub fine-grained personal access token with Contents: Read and write on the
# mlac/infosecfollow repository. Used to fetch and push the generated site.
GITHUB_TOKEN=

# Push over HTTPS so the token credential helper applies (the run script points
# origin here). Leave as-is unless the repo moves.
GIT_REMOTE_URL=https://github.com/mlac/infosecfollow.git

# Commit identity for the automated "briefing ..." commits. Leave both blank to
# use the defaults shown (a blank value is treated as unset).
GIT_AUTHOR_NAME=infosecfollow-bot
GIT_AUTHOR_EMAIL=infosecfollow@users.noreply.github.com

# Optional: dead-man monitor. Every successful cycle GETs this URL (and
# "<url>/fail" on failure), so a missed slot raises an alert instead of going
# unnoticed. Works with healthchecks.io, Uptime Kuma push monitors, etc.
# Set the monitor's grace period to about 15 hours; the longest scheduled gap
# is 12.5 h (Saturday evening to Sunday morning) and 15 h is what the
# container health check uses.
#HEARTBEAT_URL=

# Optional engine knobs (defaults shown). "opus"/"sonnet" are Claude CLI aliases
# for the newest model of each family; the fallback engages when the primary
# is overloaded or retired. Full model ids also work.
#INFOSECFOLLOW_MODEL=opus
#INFOSECFOLLOW_FALLBACK_MODEL=sonnet
# Days of archive/data files to keep on the site; 0 keeps everything.
#INFOSECFOLLOW_ARCHIVE_RETENTION_DAYS=0
# Footer sentence describing the update schedule (keep in step with scheduler.sh).
#INFOSECFOLLOW_SCHEDULE_NOTE=Updated weekdays at about 7:05 AM, 10:05 AM, 1:35 PM, and 7:35 PM ET, and weekends at about 8:05 AM and 7:35 PM ET.
